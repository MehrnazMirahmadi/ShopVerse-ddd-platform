    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\InventoryService\IdentityServer.Infrastructure\ShopVerse.IdentityServer.Infrastructure\ShopVerse.IdentityServer.Infrastructure.csproj" />
